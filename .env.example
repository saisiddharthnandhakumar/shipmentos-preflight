# Copy to .env.local and fill in. Never commit real values.

# Neon pooled connection string (host contains "-pooler") used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/shipmentos?sslmode=require"
# Neon direct (unpooled) connection string used only for migrations and seeds.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/shipmentos?sslmode=require"

# Google Gemini (server-only). Used ONLY to turn chat messages into typed patches.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional: override session lifetime in days (default 7).
SESSION_TTL_DAYS="7"
